# ==============================================================================
# ShopMicro Local Environment Variables Template (.env.example)
#
# INSTRUCTIONS:
# Copy this file to '.env' in the repository root and customize as needed:
#   cp .env.example .env
#
# SECURITY NOTICE:
# Never commit actual production credentials or production secrets to Git.
# ==============================================================================

# Catalog API Local Host Port (Default: 5001 per ADR-004)
CATALOG_PORT=5001

# Catalog PostgreSQL Database Configuration (Port: 5432 per ADR-004)
POSTGRES_PORT=5432
POSTGRES_DB=catalogdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Order Microsoft SQL Server Configuration (Port: 1433 per ADR-004)
MSSQL_PORT=1433
MSSQL_SA_PASSWORD=Password123!

# ASP.NET Core Runtime Environment (Development | Staging | Production)
ASPNETCORE_ENVIRONMENT=Development

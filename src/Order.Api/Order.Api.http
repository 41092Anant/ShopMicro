@Order.Api_HostAddress = http://localhost:5002
@orderId = 00000000-0000-0000-0000-000000000000
@productId = 00000000-0000-0000-0000-000000000000

### 1. OpenAPI Document
# Retrieves the OpenAPI specification generated by ASP.NET Core (.NET 10)
GET {{Order.Api_HostAddress}}/openapi/v1.json
Accept: application/json

###

### 2. POST - Create Order (Success: 201 Created)
# Synchronously queries Catalog.Api (port 5001) to validate product price/name snapshot.
# Replace {{productId}} with an active product GUID from Catalog.Api.
POST {{Order.Api_HostAddress}}/orders
Content-Type: application/json
Accept: application/json

{
  "customerEmail": "sarah.connor@example.com",
  "items": [
    {
      "productId": "{{productId}}",
      "quantity": 2
    }
  ]
}

###

### 3. POST - Create Order (Validation Failure: 400 Bad Request)
# Invalid email format and zero quantity triggers automatic RFC 7807 ValidationProblemDetails.
POST {{Order.Api_HostAddress}}/orders
Content-Type: application/json
Accept: application/json

{
  "customerEmail": "not-a-valid-email",
  "items": [
    {
      "productId": "00000000-0000-0000-0000-000000000000",
      "quantity": 0
    }
  ]
}

###

### 4. POST - Create Order (Empty Items List: 400 Bad Request)
# MinLength(1) validation rejects empty items list.
POST {{Order.Api_HostAddress}}/orders
Content-Type: application/json
Accept: application/json

{
  "customerEmail": "sarah.connor@example.com",
  "items": []
}

###

### 5. POST - Create Order (Product Not Found in Catalog: 400 ProblemDetails)
# Requests a non-existent product in Catalog.Api. Returns 400 ProblemDetails.
POST {{Order.Api_HostAddress}}/orders
Content-Type: application/json
Accept: application/json

{
  "customerEmail": "sarah.connor@example.com",
  "items": [
    {
      "productId": "ffffffff-ffff-ffff-ffff-ffffffffffff",
      "quantity": 1
    }
  ]
}

###

### 6. GET Order by ID (Success: 200 OK)
# Replace {{orderId}} with a GUID returned by the POST request above.
GET {{Order.Api_HostAddress}}/orders/{{orderId}}
Accept: application/json

###

### 7. GET Order by ID (Not Found: 404 ProblemDetails)
# Requests a non-existent order GUID. Returns RFC 7807 ProblemDetails.
GET {{Order.Api_HostAddress}}/orders/ffffffff-ffff-ffff-ffff-ffffffffffff
Accept: application/json

###

### 8. GET Order with invalid GUID format (Route Constraint: 404 Not Found)
# Route constraint {id:guid} rejects non-GUID parameters before hitting controller logic.
GET {{Order.Api_HostAddress}}/orders/invalid-order-guid
Accept: application/json

###

@Catalog.Api_HostAddress = http://localhost:5001
@productId = 00000000-0000-0000-0000-000000000000

### 1. OpenAPI Document
# Retrieves the OpenAPI specification generated by ASP.NET Core
GET {{Catalog.Api_HostAddress}}/openapi/v1.json
Accept: application/json

###

### 2. GET all products
# Retrieves the list of all products in the catalog
GET {{Catalog.Api_HostAddress}}/products
Accept: application/json

###

### 3. POST - Create Product (Success: 201 Created)
# Creates a new product. Note the Location header in the response pointing to /products/{id}
POST {{Catalog.Api_HostAddress}}/products
Content-Type: application/json
Accept: application/json

{
  "name": "Wireless Mechanical Keyboard",
  "description": "RGB backlit mechanical keyboard with hot-swappable switches",
  "price": 89.99
}

###

### 4. POST - Create Product (Validation Failure: 400 Bad Request)
# Triggers validation errors (empty name, negative price).
# Returns RFC 7807 ValidationProblemDetails.
POST {{Catalog.Api_HostAddress}}/products
Content-Type: application/json
Accept: application/json

{
  "name": "",
  "description": "Invalid product payload",
  "price": -15.00
}

###

### 5. GET product by ID (Success: 200 OK)
# Replace {{productId}} with a GUID returned by the POST request above
GET {{Catalog.Api_HostAddress}}/products/{{productId}}
Accept: application/json

###

### 6. GET product by ID (Not Found: 404 ProblemDetails)
# Requests a non-existent GUID. Returns structured RFC 7807 ProblemDetails.
GET {{Catalog.Api_HostAddress}}/products/ffffffff-ffff-ffff-ffff-ffffffffffff
Accept: application/json

###

### 7. GET product with invalid GUID format (Route Constraint: 404 Not Found)
# Route constraint {id:guid} rejects non-GUID parameters before hitting controller logic
GET {{Catalog.Api_HostAddress}}/products/not-a-valid-guid
Accept: application/json

###

### 8. PUT - Update Product (Success: 200 OK)
# Updates an existing product's fields. Replace {{productId}} with an existing GUID.
PUT {{Catalog.Api_HostAddress}}/products/{{productId}}
Content-Type: application/json
Accept: application/json

{
  "name": "Wireless Mechanical Keyboard (Updated Edition)",
  "description": "Upgraded with silent switches and extended battery life",
  "price": 99.99,
  "isActive": true
}

###

### 9. PUT - Update Product (Not Found: 404 ProblemDetails)
# Attempts to update a product that does not exist in the database.
PUT {{Catalog.Api_HostAddress}}/products/ffffffff-ffff-ffff-ffff-ffffffffffff
Content-Type: application/json
Accept: application/json

{
  "name": "Ghost Product",
  "description": "Does not exist in DB",
  "price": 49.99,
  "isActive": false
}

###

### 10. PUT - Update Product (Validation Failure: 400 Bad Request)
# Triggers validation failure on PUT request
PUT {{Catalog.Api_HostAddress}}/products/{{productId}}
Content-Type: application/json
Accept: application/json

{
  "name": "",
  "description": "Missing required name",
  "price": 0.00,
  "isActive": true
}

###

### 11. DELETE product (Success: 204 No Content)
# Deletes the product. Replace {{productId}} with an existing GUID.
DELETE {{Catalog.Api_HostAddress}}/products/{{productId}}

###

### 12. DELETE product (Not Found: 404 ProblemDetails)
# Attempts to delete a non-existent product. Returns RFC 7807 ProblemDetails.
DELETE {{Catalog.Api_HostAddress}}/products/ffffffff-ffff-ffff-ffff-ffffffffffff
Accept: application/json
